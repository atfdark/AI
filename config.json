{
  "apps": {
    "Chrome": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "VS Code": "C:\\Users\\%USERNAME%\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe",
    "Notepad": "notepad.exe",
    "Edge": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
    "Spotify": "C:\\Users\\%USERNAME%\\AppData\\Local\\Microsoft\\WindowsApps\\Spotify.exe"
  },
  "wake_word": {
    "enabled": true,
    "word": "jarvis",
    "timeout": 300,
    "require_for_commands": false
  },
  "language": {
    "default": "en",
    "supported": [
      "en",
      "hi"
    ],
    "vosk_models": {
      "en": "path/to/english/model",
      "hi": "path/to/hindi/model"
    }
  },
  "speech_recognition": {
    "preferred_engine": "auto",
    "network_auto_switch": true,
    "vosk_model_path": null,
    "noise_reduction": true,
    "energy_threshold": 300,
    "dynamic_energy_threshold": true,
    "ml_asr": {
      "enabled": true,
      "model": "whisper",
      "model_size": "base",
      "offline": true,
      "device": "cpu",
      "language": null,
      "fine_tune_data_path": "whisper_training_data.json"
    }
  },
  "newsapi": {
    "api_key": "YOUR_NEWSAPI_KEY_HERE"
  },
  "elevenlabs": {
    "api_key": "sk_1bf3ecb29a51fd9b5eaf662f707ffa548937dd8337e6a180"
  },
  "dialogue_state": {
    "enabled": true,
    "max_history": 50,
    "session_timeout": 1800,
    "persistence": {
      "user_preferences": true,
      "conversation_history": true
    }
  },
  "text_correction": {
    "enabled": true,
    "ml_correction": {
      "enabled": true,
      "model_type": "t5",
      "model_name": "t5-small",
      "device": "cpu",
      "max_length": 128,
      "domain_fine_tuning": {
        "enabled": true,
        "voice_assistant_model": "t5-base-voice-assistant",
        "asr_error_model": "t5-base-asr-correction"
      }
    },
    "hybrid_system": {
      "ml_first": true,
      "fallback_to_rules": true,
      "combine_scores": true,
      "ml_weight": 0.7,
      "rules_weight": 0.3
    },
    "max_edit_distance": 2,
    "min_confidence_threshold": 0.6,
    "domain_specific_enabled": true,
    "learning_enabled": true
  },
  "agent": {
    "enabled": true,
    "enable_ollama": true,
    "ollama_model": "tinyllama:latest",
    "ollama_url": "http://localhost:11434/api/generate",
    "ollama_timeout_seconds": 20,
    "low_confidence_threshold": 0.55,
    "speak_responses": true
  },
  "cloud_llm": {
    "enabled": false,
    "provider": "anthropic",
    "timeout_seconds": 25,
    "anthropic_api_key": "",
    "anthropic_model": "claude-3-5-sonnet-latest",
    "anthropic_url": "https://api.anthropic.com/v1/messages",
    "gemini_api_key": "",
    "gemini_model": "gemini-1.5-flash",
    "gemini_url_base": "https://generativelanguage.googleapis.com/v1beta"
  },
  "tts": {
    "engine": "edge_tts",
    "edge_tts": {
      "voice": "en-US-GuyNeural",
      "rate": "+0%",
      "pitch": "+0Hz",
      "volume": "+0%",
      "output_format": "riff-24khz-16bit-mono-pcm"
    }
  },
  "memory": {
    "db_path": "data_versions/semantic_memory.db",
    "enable_embeddings": true,
    "embedding_model": "all-MiniLM-L6-v2"
  },
  "semantic_file_search": {
    "db_path": "data_versions/file_index.db",
    "enable_embeddings": true,
    "embedding_model": "all-MiniLM-L6-v2",
    "max_chars_per_file": 3000,
    "max_files_per_index": 3000,
    "auto_index_on_start": false
  },
  "knowledge_brain": {
    "db_path": "data_versions/knowledge_brain.db",
    "enable_embeddings": true,
    "embedding_model": "all-MiniLM-L6-v2",
    "chunk_size_chars": 1200,
    "chunk_overlap_chars": 180,
    "ocr_enabled": true,
    "trust_overrides": {
      "wikipedia": 0.58,
      "textbook": 0.9,
      "research": 0.93
    },
    "default_source_dir": "knowledge_sources",
    "max_files_per_ingest": 500,
    "auto_ingest_on_start": true,
    "schedule": {
      "enabled": true,
      "interval_minutes": 30
    }
  },
  "knowledge_corpus": {
    "registry_path": "knowledge_sources/dataset_registry.json",
    "default_bundle": "starter",
    "auto_ingest_registered_on_start": false,
    "max_files_per_dataset": 2000
  },
  "safety_policy": {
    "require_confirmation": [
      "delete_file",
      "shutdown_system",
      "restart_system"
    ],
    "blocked_tools": [],
    "blocked_path_keywords": [
      "windows",
      "system32",
      "program files"
    ],
    "rate_limit": {
      "calls_per_minute": 60
    }
  },
  "voice_settings": {},
  "safety": {
    "confirm_delete": false,
    "confirm_shutdown": false,
    "confirm_website": false
  }
}